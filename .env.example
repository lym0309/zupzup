# docker compose 용 환경변수 (cp .env.example .env)
# ⚠️ .env는 커밋 금지

DB_ROOT_PASSWORD=change-me-root
DB_NAME=zupzup
DB_USER=oss
DB_PASSWORD=change-me

# 내 PC에서 3306/3000 포트가 이미 사용 중이면 바꾸기 (backend/.env의 DB_PORT도 같이)
DB_HOST_PORT=3306
BACKEND_HOST_PORT=3000

# 허용할 프론트 주소 (쉼표로 구분)
CORS_ORIGIN=http://localhost:5173

# 경찰청 습득물 API 인증키
POLICE_API_KEY=
# 경찰청 포털기관(공공기관) 습득물 API 인증키
POLICE_PT_API_KEY=

# 습득물 주기 수집 (서버 실행 중 자동). 끄려면 false
COLLECT_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
COLLECT_DAYS=30
COLLECT_RECENT_DAYS=3

# 카카오 로컬 API REST 키 (보관기관 좌표 검색, 없으면 지도 좌표 없이 동작)
KAKAO_REST_API_KEY=

# Gemini API 키 (분실물 문장 → 검색 조건 추출, 없으면 추출 없이 직접 고르기 화면으로)
GEMINI_API_KEY=
# 시도할 모델 순서 (쉼표로 구분, 비우면 기본값). 앞 모델이 과부하(503) 등으로 실패하면 다음 모델
GEMINI_MODELS=
# 추출 제한 시간 (ms, 기본 12000). 넘으면 직접 고르기 화면으로
GEMINI_TIMEOUT_MS=
