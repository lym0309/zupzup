# 로컬에서 `npm run dev`로 서버를 띄울 때 사용 (cp .env.example .env)
# ⚠️ .env는 커밋 금지

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL (docker compose up -d mysql 로 띄운 로컬 DB 기준)
DB_HOST=localhost
DB_PORT=3306
DB_USER=oss
DB_PASSWORD=change-me
DB_NAME=zupzup

# 경찰청 습득물 API (공공데이터포털 > 마이페이지 > 일반 인증키)
POLICE_API_KEY=
# 경찰청 포털기관(공공기관) 습득물 API 인증키
POLICE_PT_API_KEY=

# 습득물 주기 수집 (서버 실행 중 자동). 끄려면 false
COLLECT_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
COLLECT_DAYS=30
COLLECT_RECENT_DAYS=3

# 카카오 로컬 API REST 키 (보관기관 좌표 검색, 없으면 지도 좌표 없이 동작)
KAKAO_REST_API_KEY=

# Gemini API 키 (분실물 문장 → 검색 조건 추출, 없으면 추출 없이 직접 고르기 화면으로)
GEMINI_API_KEY=
# 시도할 모델 순서 (쉼표로 구분, 비우면 기본값). 앞 모델이 과부하(503) 등으로 실패하면 다음 모델
GEMINI_MODELS=
# 추출 제한 시간 (ms, 기본 12000). 넘으면 직접 고르기 화면으로
GEMINI_TIMEOUT_MS=
